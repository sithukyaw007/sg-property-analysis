# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
.venv/
env/

# Browser data (generated at runtime)
chrome-profile/

# Output files (generated per analysis run)
output/*.json
output/*.md
output/*.csv
output/*.txt
output/run_*/
# Weekly-scan digests + agent transcripts. Machine-local like every other
# output/ artifact — the durable record of a scan is the evaluation it writes to
# evaluations/ (tracked) and the store's scan-finds note.
output/weekly/
output/weekly_runs/
output/analyze_runs/

# Playwright MCP cache
.playwright-mcp/

# Poller runtime state (rewritten every cycle, machine-local)
data/poll_state.json
# Weekly-scan runtime state (which weeks already ran — machine-local)
data/weekly_state.json
# Zero-byte mutex files (listings_db / mmr_history / realsmart cache). Two are
# already tracked from before this rule — an ignore doesn't untrack them, it just
# stops new ones (e.g. data/realsmart_projects.json.lock) being committed.
data/*.lock

# Leftovers from the retired DAILY scan — the loop is weekly and hand-run now
# (weekly.py). Kept ignored so an old checkout's empty dirs don't reappear.
output/daily/
output/daily_runs/

# data/*.csv files are tracked deliberately — they are the data backbone
# (listings sheet, MMR/arena history, URA cache export, raw URA downloads)

# Runtime credential files (auto-generated)
cookies.json
user_agent.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Claude Code local config (skills ARE tracked — shared project runbooks)
.claude/settings.local.json
.claude/worktrees/

# DB backfill safety copies
*.bak

# realsmart slug index (regenerable: python realsmart.py --refresh)
data/realsmart_slugs.json

# Per-project bedroom bands (regenerable: python bed_bands.py --build)
data/bed_bands.json

# temp/lock files from ura_api exports and eval-memory index rebuilds
data/*.csv.tmp
evaluations/*.lock

# Personal buyer profile (fork-local; see profile.example.json / buyer_profile.py)
profile.local.json
# Personal derived data: commute times, personal-fit scores (machine-local)
data/personal/
